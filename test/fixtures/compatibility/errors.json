{
  "cases": [
    {
      "name": "map requires frontier flag",
      "operation": "pickup_map_without_frontier_selection",
      "expected": { "code": "ticket_required", "stage": "resolve", "recoverable": false }
    },
    {
      "name": "frontier requires map",
      "operation": "list_frontier_for_ticket",
      "expected": { "code": "frontier_requires_map", "stage": "resolve", "recoverable": false }
    },
    {
      "name": "resume requires manifest",
      "operation": "resume_without_manifest",
      "expected": { "code": "resume_not_found", "stage": "preflight", "recoverable": false }
    },
    {
      "name": "claim race prevents local mutation",
      "operation": "pickup_with_claim_race",
      "expected": {
        "code": "claim_race",
        "stage": "claim",
        "recoverable": true,
        "worktreesCreated": 0,
        "threadsCreated": 0
      }
    },
    {
      "name": "worktree failure is compensated",
      "operation": "pickup_with_worktree_failure",
      "expected": {
        "code": "git_worktree_failed",
        "stage": "git",
        "recoverable": true,
        "claimRolledBack": true,
        "threadsCreated": 0
      }
    },
    {
      "name": "bootstrap failure remains resumable",
      "operation": "pickup_with_session_bootstrap_failure",
      "expected": {
        "code": "t3_bootstrap_failed",
        "stage": "t3",
        "recoverable": true,
        "manifestState": "bootstrap_pending",
        "claimRetained": true,
        "worktreeRetained": true
      }
    }
  ]
}
